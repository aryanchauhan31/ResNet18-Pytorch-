{
        "train_batch_size": 128,
        "gradient_accumulation_astep":1,
        "bfp16": {
            "enabled": true
        },
        "zero_optimization": {
            "stage":2,
            "offload_optimizer": {
                "device": "cpu",
                "pin_memory": "true"
            },
            "offload_param": {
                "device": "cpu",
                "pin_memory": true
            }
        },
        "optimizer": {
            "type": "AdamW",
            "params": {
            "lr": 0.001,
            "betas": [0.9, 0.999],
            "eps": 1e-8,
            "weight_decay": 0.01
        }
    }
    
}